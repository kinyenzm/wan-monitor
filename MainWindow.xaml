<Window x:Class="WanMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitor WAN"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="OnDrag" MouseDoubleClick="OnDoubleClick"
        Loaded="OnLoaded" Closing="OnClosing">

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="Muted" Color="#A6A6A6"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="MiCompact" Header="Modo compacto" IsCheckable="True" Click="OnToggleCompact"/>
            <MenuItem x:Name="MiPause" Header="Pausar sonda" IsCheckable="True" Click="OnTogglePause"/>
            <Separator/>
            <MenuItem Header="Copiar resumen (para el reclamo)" Click="OnCopySummary"/>
            <MenuItem Header="Abrir carpeta de registros" Click="OnOpenLogs"/>
            <Separator/>
            <MenuItem Header="Opacidad">
                <MenuItem Header="100 %" Click="OnOpacity" Tag="1.0"/>
                <MenuItem Header="85 %" Click="OnOpacity" Tag="0.85"/>
                <MenuItem Header="70 %" Click="OnOpacity" Tag="0.7"/>
                <MenuItem Header="55 %" Click="OnOpacity" Tag="0.55"/>
            </MenuItem>
            <MenuItem x:Name="MiAutostart" Header="Iniciar con Windows" IsCheckable="True" Click="OnToggleAutostart"/>
            <MenuItem Header="Reiniciar estadísticas" Click="OnResetStats"/>
            <Separator/>
            <MenuItem Header="Salir" Click="OnExit"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="Root" Margin="8" CornerRadius="10" Padding="12,9" Background="#E61C1C1E" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel MinWidth="230">

            <!-- fila principal -->
            <DockPanel LastChildFill="True">
                <Ellipse x:Name="Dot" Width="12" Height="12" Fill="#2ECC71" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtLatency" Style="{StaticResource MutedText}" DockPanel.Dock="Right" VerticalAlignment="Center" Text="— ms"/>
                <TextBlock x:Name="TxtStatus" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Text="Iniciando…"/>
            </DockPanel>

            <!-- cuenta regresiva al próximo corte -->
            <TextBlock x:Name="TxtNext" Margin="0,6,0,0" Text="Próximo corte: sin datos"/>

            <!-- detalle (oculto en modo compacto) -->
            <StackPanel x:Name="Details" Margin="0,6,0,0">
                <TextBlock x:Name="TxtToday" Style="{StaticResource MutedText}" Text="Hoy: 0 cortes · 0:00 caído · 100,00 %"/>
                <TextBlock x:Name="TxtLast" Style="{StaticResource MutedText}" Text="Último: —"/>
                <TextBlock x:Name="TxtPeriod" Style="{StaticResource MutedText}" Text="Periodo: — · gateway —"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
